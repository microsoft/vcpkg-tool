<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)GetGlobalProperties.task" />
  <PropertyGroup>
    <SpecialCharacters>semicolon%3Bpercent%25apostrophe%27paren%28%29dollar%24at%40</SpecialCharacters>
    <ExpectedHostTriplet>host%3Bwith%25percent%27apostrophe%28%29%24%40</ExpectedHostTriplet>
    <!-- GetVcpkgEnvVars encodes semicolons as literal %3B sequences. -->
    <ExpectedEnvironmentEntry>____VCPKG_TEST_INSTALL_PROPERTIES=semicolon%253Bliteral%253Bpercent%2525____</ExpectedEnvironmentEntry>
  </PropertyGroup>
  <Target Name="VcpkgInstallImplementation">
    <GetGlobalProperties>
      <Output TaskParameter="GlobalPropertyNames" PropertyName="InstallGlobalPropertyNames" />
    </GetGlobalProperties>
    <ItemGroup>
      <UnexpectedGlobalProperties Include="$([MSBuild]::Unescape($(InstallGlobalPropertyNames)))"
                                  Exclude="_ZVcpkgMSBuildStampFile;_ZVcpkgRoot;_ZVcpkgHostTripletSuffix;_ZVcpkgInstalledDir;_ZVcpkgExecutable;_ZVcpkgHostTripletParameter;VcpkgTriplet;_ZVcpkgManifestRoot;VcpkgAdditionalInstallOptions;_ZVcpkgEnvVars" />
    </ItemGroup>
    <Error Condition="'$(VcpkgAdditionalInstallOptions)' != '--overlay-ports=fixture;--binarysource=clear'"
           Text="Install options were lost or incorrectly escaped: $(VcpkgAdditionalInstallOptions)" />
    <Error Condition="'$(VcpkgTriplet)' != 'x64-windows'" Text="The explicit triplet was lost." />
    <Error Condition="'@(UnexpectedGlobalProperties)' != ''"
           Text="Unrelated global properties leaked into the install child: @(UnexpectedGlobalProperties)" />
    <Error Condition="'$(_ZVcpkgRoot)' == '' or '$(_ZVcpkgManifestRoot)' == '' or '$(_ZVcpkgInstalledDir)' == '' or '$(_ZVcpkgMSBuildStampFile)' == '' or '$(_ZVcpkgExecutable)' == ''"
           Text="Required install properties were lost." />
    <Error Condition="$(_ZVcpkgRoot.Contains('special-characters')) and (!$(_ZVcpkgRoot.Contains($(SpecialCharacters))) or !$(_ZVcpkgManifestRoot.Contains($(SpecialCharacters))) or !$(_ZVcpkgInstalledDir.Contains($(SpecialCharacters))) or !$(_ZVcpkgMSBuildStampFile.Contains($(SpecialCharacters))) or !$(_ZVcpkgExecutable.Contains($(SpecialCharacters))))"
           Text="Special characters in install paths were lost or incorrectly escaped." />
    <Error Condition="$(_ZVcpkgRoot.Contains('special-characters')) and ('$(_ZVcpkgHostTripletSuffix)' != '$(ExpectedHostTriplet).' or '$(_ZVcpkgHostTripletParameter)' != '&quot;--host-triplet=$(ExpectedHostTriplet)&quot;')"
           Text="Special characters in host triplet properties were lost or incorrectly escaped." />
    <PropertyGroup>
      <InstallEnvironmentEntries>____$(_ZVcpkgEnvVars)____</InstallEnvironmentEntries>
    </PropertyGroup>
    <Error Condition="!$(InstallEnvironmentEntries.Contains($(ExpectedEnvironmentEntry)))"
           Text="The controlled environment value was lost or incorrectly escaped in the install child." />
    <MakeDir Directories="$(_ZVcpkgRoot)" />
    <Message Text="Validated install properties for $(_ZVcpkgRoot)" Importance="High" />
  </Target>
</Project>
